<!DOCTYPE html>
<html data-theme="<%- app.theme %>" lang="pl">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <header>
      <h1>Mini Blog</h1>
      <nav>
        <a href="/">Strona główna</a>
        <a href="/about">O projekcie</a>
        <a href="/settings/toggle-theme?next=<%- encodeURIComponent(page) %>">
        <% if (app.theme === "light") { %>
        <strong>Jasny</strong> | Ciemny
        <% } else { %>
        Ciemny | <strong>Jasny</strong>
        <% } %>
        </a>
        <% if (user) { %>
          <span class="user-badge"><%= user.email %></span>
          <button data-action="logout">Wyloguj</button>
        <% } else { %>
          <button data-action="login">Logowanie</button>
          <button data-action="register">Rejestracja</button>
        <% } %>
      </nav>
    </header>

    <% if (!user) { %>
    <div id="login-modal" class="modal" aria-hidden="true">
      <div class="modal-content" role="dialog" aria-modal="true" aria-label="Formularz logowania">
        <button class="modal-close" aria-label="Zamknij">×</button>
        <h3>Logowanie</h3>
        <form id="login-form">
          <p class="form-error" aria-live="polite"></p>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" placeholder="twoj@email.pl" required>

          <label for="password">Hasło</label>
          <input id="password" name="password" type="password" placeholder="Hasło" required>

          <div class="modal-actions">
            <button type="submit">Zaloguj</button>
            <button type="button" class="modal-cancel">Anuluj</button>
          </div>
        </form>
      </div>
    </div>

    <div id="register-modal" class="modal" aria-hidden="true">
      <div class="modal-content" role="dialog" aria-modal="true" aria-label="Formularz rejestracji">
        <button class="modal-close" aria-label="Zamknij">×</button>
        <h3>Rejestracja</h3>
        <form id="register-form">
          <p class="form-error" aria-live="polite"></p>
          <label for="reg-first">Imię</label>
          <input id="reg-first" name="firstName" type="text" placeholder="Imię" required>

          <label for="reg-last">Nazwisko</label>
          <input id="reg-last" name="lastName" type="text" placeholder="Nazwisko" required>

          <label for="reg-age">Wiek</label>
          <input id="reg-age" name="age" type="number" min="0" max="150" placeholder="Wiek" required>

          <label for="reg-email">Email</label>
          <input id="reg-email" name="email" type="email" placeholder="twoj@email.pl" required>

          <label for="reg-password">Hasło</label>
          <input id="reg-password" name="password" type="password" placeholder="Hasło" required>

          <div class="modal-actions">
            <button type="submit">Zarejestruj</button>
            <button type="button" class="modal-cancel">Anuluj</button>
          </div>
        </form>
      </div>
    </div>
    <% } %>

    <main>
      <section class="form-section">
        <h2>Dodaj nowy post</h2>
        <% if (error === "login_required") { %>
          <p class="notice notice-warn">Musisz być zalogowany, żeby dodać post.</p>
        <% } %>
        <% if (user) { %>
        <form action="/add" method="POST">
          <input type="text" name="title" placeholder="Tytuł posta" required />
          <textarea name="content" placeholder="Treść posta" required></textarea>
          <button type="submit">Dodaj</button>
        </form>
        <% } else { %>
          <p class="notice">Zaloguj się, aby móc dodawać posty.</p>
        <% } %>
      </section>

      <section class="posts">
        <h2>Wszystkie posty</h2>
        <% if (posts.length === 0) { %>
          <p>Brak postów. Dodaj coś!</p>
        <% } else { %>
          <% posts.forEach(post => { %>
            <article class="post">
              <h3><%= post.title %></h3>
              <p><%= post.content %></p>
              <div class="post-meta">
                <span class="date"><%= post.date %> | <%= post.firstName %> <%= post.lastName %></span>
                <% if (user && Number(user.id) === Number(post.authorId)) { %>
                  <div class="post-actions">
                    <a class="post-action post-edit" href="/posts/<%= post.id %>/edit">Edytuj</a>
                    <form class="post-delete-form" action="/posts/<%= post.id %>/delete" method="POST">
                      <button class="post-action post-delete" type="submit">Usuń</button>
                      <p class="inline-error" aria-live="polite"></p>
                    </form>
                  </div>
                <% } %>
              </div>
            </article>
          <% }) %>
        <% } %>
      </section>
    </main>

    <%- include('partials/foot') %>

  </body>
</html>
