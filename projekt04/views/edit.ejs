<!DOCTYPE html>
<html data-theme="<%- app.theme %>" lang="pl">
  <head>
    <%- include("partials/head") %>
  </head>
  <body>
    <header>
      <h1>Wędkarski Blog</h1>
      <nav>
        <a href="/">Strona główna</a>
        <a href="/about">O projekcie</a>
      </nav>
    </header>

    <main>
      <section class="form-section">
        <h2>Edycja posta</h2>
        <form action="/posts/<%= post.id %>/edit" method="POST">
          <input type="text" name="title" value="<%= post.title %>" maxlength="120" required />
          <textarea name="content" maxlength="5000" required><%= post.content %></textarea>
          <div class="modal-actions">
            <button type="submit">Zapisz</button>
            <a class="btn-secondary" href="/">Anuluj</a>
          </div>
        </form>
      </section>
    </main>

    <%- include("partials/foot") %>
  </body>
</html>
