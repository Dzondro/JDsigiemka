<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include("partials/head") %>
</head>
<body>
  <%- include("partials/nav") %>

  <div class="container">
    <h2>Wszystkie wpisy</h2>

    <% posts.forEach(post => { %>
      <div class="post">
        <h3><%= post.title %></h3>
        <p><%= post.content %></p>

        <form action="/delete/<%= post.id %>" method="POST" style="display:inline;">
          <button class="delete">Usuń</button>
        </form>

        <a href="/edit/<%= post.id %>">Edytuj</a>
      </div>
    <% }) %>

    <h2>Dodaj nowy wpis</h2>
    <form action="/add" method="POST">
      <input type="text" name="title" placeholder="Tytuł" required>
      <textarea name="content" placeholder="Treść" required></textarea>
      <button type="submit">Dodaj</button>
    </form>

    <h2>Wypełnij bazę danymi testowymi</h2>
    <form action="/seed" method="POST">
      <button type="submit">Wypełnij przykładowymi danymi</button>
    </form>
  </div>
</body>
</html>
